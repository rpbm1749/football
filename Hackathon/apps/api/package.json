{
  "name": "@football/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API for tactical analysis. Thin I/O layer over the @football/compute worker pool.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@football/compute": "0.1.0",
    "@football/engine": "0.1.0",
    "@football/protocol": "0.1.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7",
    "@fastify/websocket": "^11.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "@types/ws": "^8.18.1"
  }
}
